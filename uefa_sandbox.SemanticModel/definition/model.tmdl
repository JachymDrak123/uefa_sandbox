model Model
	culture: cs-CZ
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: cs-CZ
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["fact_team_stats","dim_team","fact_player_stats"]

ref table fact_team_stats
ref table dim_team
ref table fact_player_stats

ref cultureInfo cs-CZ

